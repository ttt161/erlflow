{application, erlflow,
 [{description, "Simple netflow to prometheus converter and pre-analyzer"},
  {vsn, "1.0.0"},
  {registered, []},
  {mod, {erlflow_app, []}},
  {applications,
   [kernel,
    stdlib,
    yamerl,
    prometheus,
    cowboy
   ]},
  {env,[]},
  {modules, []},

  {licenses, ["MIT"]},
  {links, [
    {"Github", "https://github.com/ttt161/erlflow"}
  ]}
 ]}.
